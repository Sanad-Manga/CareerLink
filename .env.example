PORT=5000

#Database setup
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/giu-nexus?appName=Cluster0
MONGO_URI_DOCKER=mongodb://mongo:27017/giu-nexus
MONGO_PORT=27017
MONGO_DB_NAME=giu-nexus

JWT_SECRET=your-jwt-secret-here
JWT_EXPIRE=7d

#Hugging face token
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

#Required for nodemailer to work (forgot password)
EMAIL_HOST=your-email-host-here
EMAIL_PORT=587
EMAIL_USER=your-email-here
EMAIL_PASS=your-email-password-here 

#cloudinary credentials for the Profile picture to work
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
